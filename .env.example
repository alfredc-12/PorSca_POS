# Expo app. Use the computer's LAN IP for a physical phone; never localhost.
EXPO_PUBLIC_APP_ENV=development
# Laravel staging/local API base, including its version prefix.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000/api/v1
# Sign in on the phone with an API-managed account. No token belongs in this file.

# Offline demo catalog. Off unless this is exactly 1. While it is off, an
# unreachable API shows an offline state instead of substituting seeded products,
# and no sale can be recorded locally.
# EXPO_PUBLIC_ALLOW_DEMO_CATALOG=0
